# ============================================================
# .gitignore —— 声明哪些文件只属于本机，不进入版本库
# ============================================================

# ---------- 密钥配置：真实 key 只留在本机 ----------
# 上传仓库的是 configs/config.template.json（空模板），别人复制改名后填自己的 key
configs/config.json

# ---------- 运行时数据：上传文档、向量索引、SQLite、沙箱产出 ----------
temp/
data/
knowledgebases/
db_server/data/
models/
*.db
*.log

# ---------- Python 运行产物 ----------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ---------- IDE / 本地工具 ----------
.idea/
.vscode/
.codebox/

# ---------- 本地笔记（根目录只保留 README）----------
/*.md
!/README.md

# ---------- 本地杂项 ----------
webui.pyi
黑神话悟空.txt